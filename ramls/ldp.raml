#%RAML 1.0
title: Library Data Platform API
version: v1
protocols: [ HTTP, HTTPS ]
baseUri: https://github.com/library-data-platform/mod-ldp

documentation:
  - title: Library Data Platform API
    content: API calls to obtain information generated by the LDP
  - title: Overview
    content: !include overview.md

/ldp:
  /config:
    description: "Configuration items"
    get:
      description: "Return a list of configuration items"
      responses:
        200:
          body:
            application/json:
              type: !include configuration-list.json
              example: !include examples/configuration-list.json
    /{key}:
      get:
        description: "Retrieve a single configuration by key"
        responses:
          200:
            body:
              application/json:
                type: !include configuration.json
                example: !include examples/configuration.json
      put:
        description: "Modify or add a configuration by key"
        body:
          application/json:
            type: !include configuration.json
            example: !include examples/configuration.json
        responses:
          200:
            body:
              application/json:
                type: !include configuration.json
                example: !include examples/configuration.json

  /db:
    /tables:
      description: "Tables in their respective schemas"
      get:
        description: "Return a list of all tables in all schemas"
        responses:
          200:
            body:
              application/json:
                type: !include tables-schema.json
                example: !include examples/tables-example.json
    /columns:
      description: "Columns in their table"
      get:
        description: "Return a list of all columns in a table. Example: /ldp/db/columns?schema=public&table=user_users"
        queryParameters:
          schema:
            description: The name of the schema containing the specified table
            type: string
            required: true
            example: public
          table:
            description: The name of the table within the specified schema
            type: string
            required: true
            example: user_users
        responses:
          200:
            body:
              application/json:
                type: !include columns-schema.json
                example: !include examples/columns-example.json
    /query:
      description: "Query the LDP service"
      post:
        description: "Send a query to the LDP server and obtain results"
        body:
          application/json:
            type: !include query-schema.json
            example: !include examples/query-example.json
        responses:
          200:
            body:
              application/json:
                type: !include results-schema.json
                example: !include examples/results-example.json
    /reports:
      description: "Run a parameterized report against the LDP server"
      post:
        body:
          application/json:
            type: !include template-query-schema.json
            example: !include examples/template-query-example.json
        responses:
          200:
            body:
              application/json:
                type: !include template-results-schema.json
                example: !include examples/template-results-example.json
          403:
            description: "The report is not in any configured report repository; or the user is not authorized to run reports from its repository; or the repository is restricted and there was no X-Okapi-User-Id header to identify the user"
            body:
              text/plain:
                example: "cannot run report https://raw.githubusercontent.com/seneyl/test_reports/main/circulation/visiting_researchers.sql: user 01a0fe88-4ee9-4d8f-af08-352fbea6de36 is not authorized to run reports from repository github:seneyl/test_reports@main:circulation"
          500:
            description: "The report could not be run: for example, because the configured report repositories could not be loaded, the report could not be fetched, or it failed in the database"
            body:
              text/plain:
                example: "cannot run report https://raw.githubusercontent.com/seneyl/test_reports/main/circulation/visiting_researchers.sql: could not load the configured report repositories from mod-settings: ..."

    /version:
      description: "The current Metadb version"
      get:
        description: "Return a set of name-value pairs describing the Metadb version and maybe other relevant information"
        responses:
          200:
            body:
              application/json:
                type: !include version-schema.json
                example: !include examples/version-example.json
    /updates:
      description: "Details on most recent updates to tables"
      get:
        description: "Return a list of tables with their update timestamps"
        responses:
          200:
            body:
              application/json:
                type: !include updates-schema.json
                example: !include examples/updates-example.json
    /processes:
      description: "Details on long-running queries still in effect"
      get:
        description: "Return a list of long-running queries"
        responses:
          200:
            body:
              application/json:
                type: !include processes-schema.json
                example: !include examples/processes-example.json
